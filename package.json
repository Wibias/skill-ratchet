{
  "name": "skill-ratchet",
  "version": "0.1.0",
  "description": "Release engineering and regression gates for Agent Skills.",
  "type": "module",
  "bin": {
    "skill-ratchet": "skills/skill-ratchet/scripts/skill-ratchet.mjs"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node skills/skill-ratchet/scripts/skill-ratchet.mjs validate --skill-root skills/skill-ratchet",
